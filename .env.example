# =========================================================
# Client Environment Variables
# =========================================================
# คัดลอกไฟล์นี้เป็น .env.local สำหรับ local dev
# บน Vercel ให้ตั้ง environment variable ตรงๆ ใน dashboard

# URL ของ Server (Render)
# ตัวอย่าง: https://my-card-game-server.onrender.com
# ไม่ต้องใส่ /socket.io ต่อท้าย
VITE_SERVER_URL=https://your-server-name.onrender.com
